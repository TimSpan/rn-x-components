{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": false,
    "outDir": ".lib-build/dist",
    "rootDir": "src/x-components",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["esnext"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/x-components/**/*.ts", "src/x-components/**/*.tsx"],
  "exclude": ["**/__tests__/**", "**/*.test.*"]
}
