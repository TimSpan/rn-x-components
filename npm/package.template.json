    "signature",
    "skia",
    "upload",
    "minio",
    "presigned",
    "charts",
    "dark-mode",
    "i18n",
    "topview",
    "popup"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maoyuxiang/rn-x-components.git"
  },
  "peerDependencies": {
