{
  "expo": {
    "name": "x-components",
    "slug": "x-components",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/x-icon-1024.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icons/x-icon-1024.png",
      "bundleIdentifier": "com.anonymous.myapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2080F0",
        "foregroundImage": "./assets/icons/x-icon-foreground-1024.png",
        "backgroundImage": "./assets/icons/x-icon-background-1024.png",
        "monochromeImage": "./assets/icons/x-icon-monochrome-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.myapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2080F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-vector-icons/ant-design",
      "expo-audio",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
